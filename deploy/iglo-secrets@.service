# Unseals the secrets of an Iglo-OS app container into RAM before Proxmox
# starts it. The container's pve-container@ drop-in requires this unit.
[Unit]
Description=Unseal the Iglo-OS secrets of container %i

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c 'source /usr/local/lib/iglo/secrets.sh && secrets_unlock "$1"' iglo-secrets %i
