[Unit]
Description=Iglo controller HTTPS proxy
After=network-online.target nftables.service headscale.service
Requires=nftables.service
Wants=network-online.target headscale.service
[Service]
User=caddy
Group=caddy
Environment=GOMEMLIMIT=96MiB GOMAXPROCS=1
Environment=XDG_DATA_HOME=/var/lib/caddy/data XDG_CONFIG_HOME=/var/lib/caddy/config
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
MemoryMax=128M
CPUQuota=100%
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/caddy
UMask=0077
[Install]
WantedBy=multi-user.target
